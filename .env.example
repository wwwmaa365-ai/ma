# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_WEBHOOK_SECRET: Server-side HMAC-SHA256 verification secret for payment webhooks.
RAZORPAY_WEBHOOK_SECRET="sanjit_rzp_whsec_production_2026"

# SHIPROCKET_API_TOKEN: Optional server-side courier integration token.
SHIPROCKET_API_TOKEN="shiprocket_token_example"

# DELHIVERY_API_TOKEN: Optional server-side courier integration token.
DELHIVERY_API_TOKEN="delhivery_token_example"
